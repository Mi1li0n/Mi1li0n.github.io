{
  "scope": "仅依据可见正文和接话方式分型，昵称、UID、头像、签名、个人简介、账号注册时间、资料页历史帖数均不参与风格判断。",
  "activity_rules": {
    "高频参与": "可见发言至少10条，且参与至少5个主题/留言页；同一主题的分页合并。",
    "间歇参与": "可见发言4至9条；达到10条但集中在不足5个主题的也归此档。",
    "偶尔出现": "可见发言1至3条；单次发言不推断长期性格。"
  },
  "limits": [
    "活跃度只描述这批静态页面的可见参与，不代表整个虚构论坛的历史发帖数量。",
    "分类为写作倾向，不是每条话都必须符合的公式；日常回话、叙事、转帖、管理通知允许自然变化。",
    "50个小类是检查差异的目录，不要求平均分布，也不要求新增角色去凑数。",
    "禁言提示为系统文字，不算被禁言者的发言，也不据此分配性格。",
    "转帖的诗、小说、段子本体与签名不作为发言者口吻的直接证据。",
    "不增加页面中的活跃度/人格徽章，不改论坛统计、虚拟页数、会员资料或布局。"
  ],
  "categories": [
    {
      "id": "1",
      "name": "短句直说",
      "subtypes": [
        {
          "id": "1.1",
          "name": "先给结论",
          "guide": "先表态或给结果，必要时才补一条根据；少铺垫。"
        },
        {
          "id": "1.2",
          "name": "只答眼前一件",
          "guide": "一次只回一个具体点；发问也不把前因后果一次讲全。"
        },
        {
          "id": "1.3",
          "name": "偏好说得明白",
          "guide": "喜欢、不喜欢直接说，允许没有长篇理由。"
        },
        {
          "id": "1.4",
          "name": "报一下现状",
          "guide": "说眼下看到或做到的事，很少概括别人。"
        },
        {
          "id": "1.5",
          "name": "省着说",
          "guide": "常省主语或句尾，短不等于每次只发一个字。"
        }
      ]
    },
    {
      "id": "2",
      "name": "边想边说",
      "subtypes": [
        {
          "id": "2.1",
          "name": "说完又改口",
          "guide": "会修正上一句的判断，问题想到哪里问到哪里。"
        },
        {
          "id": "2.2",
          "name": "插一句补充",
          "guide": "主句中插小补充，说明容易被误解的细节。"
        },
        {
          "id": "2.3",
          "name": "分几截补完",
          "guide": "短段续写，后半截才交代关键情况。"
        },
        {
          "id": "2.4",
          "name": "记不准就说不准",
          "guide": "记忆与推测有界限，不为了接话装作很懂。"
        },
        {
          "id": "2.5",
          "name": "说着想到别处",
          "guide": "从眼前事岔出另一个念头，不必硬绕回来。"
        }
      ]
    },
    {
      "id": "3",
      "name": "拿经历来说",
      "subtypes": [
        {
          "id": "3.1",
          "name": "按发生顺序讲",
          "guide": "先做了什么、后来怎样，口语铺开，不追求段段有包袱。"
        },
        {
          "id": "3.2",
          "name": "留下动作细节",
          "guide": "记得物件、位置、动作，少用概括感受替代事情。"
        },
        {
          "id": "3.3",
          "name": "复述别人原话",
          "guide": "用听见的对话带出意见，不过度替对方总结。"
        },
        {
          "id": "3.4",
          "name": "过后再补一笔",
          "guide": "先交代眼前事，再补一个以前或后来的结果。"
        },
        {
          "id": "3.5",
          "name": "绕一段再回来",
          "guide": "允许长段旁枝，但最后能看出为什么在这个帖里说。"
        }
      ]
    },
    {
      "id": "4",
      "name": "追问和核对",
      "subtypes": [
        {
          "id": "4.1",
          "name": "先把条件问清",
          "guide": "问清是哪一种情况，不抢着给结论。"
        },
        {
          "id": "4.2",
          "name": "问具体怎么弄",
          "guide": "关注按哪儿、接下来做什么，不能突然变成全知解答者。"
        },
        {
          "id": "4.3",
          "name": "追一句为什么",
          "guide": "抓住原因不放；不是每句都必须问号。"
        },
        {
          "id": "4.4",
          "name": "摆两样来比较",
          "guide": "通过差别说困惑或选择，比较只围绕当下话题。"
        },
        {
          "id": "4.5",
          "name": "惦记后续",
          "guide": "追问结果、进展或漏掉的下文，不负责替别人收尾。"
        }
      ]
    },
    {
      "id": "5",
      "name": "愿意搭把手",
      "subtypes": [
        {
          "id": "5.1",
          "name": "先试一个办法",
          "guide": "一次给一个动作，等实际反应，不写完整客服流程。"
        },
        {
          "id": "5.2",
          "name": "拿自己的试法作参考",
          "guide": "说清自己试过的范围，没做过的直接承认。"
        },
        {
          "id": "5.3",
          "name": "解释时带例子",
          "guide": "给一个能看懂的例子，解释够用就停。"
        },
        {
          "id": "5.4",
          "name": "帮人找个去处",
          "guide": "知道别的入口或替代办法才说，不保证一定解决。"
        },
        {
          "id": "5.5",
          "name": "先指出容易踩的坑",
          "guide": "先说别急着做什么，再给可检查的细节。"
        }
      ]
    },
    {
      "id": "6",
      "name": "有异议就说",
      "subtypes": [
        {
          "id": "6.1",
          "name": "只反驳那一句",
          "guide": "指出自己不同意的具体话，不把整个人批一遍。"
        },
        {
          "id": "6.2",
          "name": "把代价算进去",
          "guide": "关注麻烦、时间、钱或可行性，措辞干脆。"
        },
        {
          "id": "6.3",
          "name": "区分两个说法",
          "guide": "爱纠正被混作一回事的细节，避免长篇说教。"
        },
        {
          "id": "6.4",
          "name": "要个根据",
          "guide": "对夸大或传闻问证据，也可以摆自己见过的反例。"
        },
        {
          "id": "6.5",
          "name": "不接受的先说",
          "guide": "先亮明边界或立场，允许在无关话题里正常闲聊。"
        }
      ]
    },
    {
      "id": "7",
      "name": "随口开个玩笑",
      "subtypes": [
        {
          "id": "7.1",
          "name": "平着说荒唐事",
          "guide": "语气平直，笑点藏在事实落差里，不再解释笑点。"
        },
        {
          "id": "7.2",
          "name": "先拿自己开涮",
          "guide": "承认自己的糗事，不靠每帖都出丑维持风格。"
        },
        {
          "id": "7.3",
          "name": "接着别人的梗往上添",
          "guide": "接已有说法放大，不凭空给每个话题塞段子。"
        },
        {
          "id": "7.4",
          "name": "顺着一句拐个弯",
          "guide": "顺着对方的字面说到旁边去，点到为止。"
        },
        {
          "id": "7.5",
          "name": "轻轻挤兑一句",
          "guide": "有一点不客气，针对当下的小事，不写成连续挑衅。"
        }
      ]
    },
    {
      "id": "8",
      "name": "陪着聊两句",
      "subtypes": [
        {
          "id": "8.1",
          "name": "挑个细节接话",
          "guide": "注意到小处再接，不把楼主整段重述一遍。"
        },
        {
          "id": "8.2",
          "name": "想起自己也有过",
          "guide": "用相近经历搭话，不宣称完全理解别人的感受。"
        },
        {
          "id": "8.3",
          "name": "像熟人那样招呼",
          "guide": "省掉郑重客套，可以认人、打招呼、随口约一下。"
        },
        {
          "id": "8.4",
          "name": "关心实际处境",
          "guide": "问人接下来怎么办、东西放哪儿等，不讲安慰大道理。"
        },
        {
          "id": "8.5",
          "name": "捎个消息",
          "guide": "替别人报信或记一件事，说清自己知道多少。"
        }
      ]
    },
    {
      "id": "9",
      "name": "情绪在前面",
      "subtypes": [
        {
          "id": "9.1",
          "name": "高兴了多说几句",
          "guide": "热情会增加字数和节奏，不要求每次三个感叹号。"
        },
        {
          "id": "9.2",
          "name": "忍不住抱怨",
          "guide": "具体烦哪件事说哪件事，容许话说得不圆。"
        },
        {
          "id": "9.3",
          "name": "有点不好意思",
          "guide": "会犹豫、绕一下再提要求，不把谦虚写成套话。"
        },
        {
          "id": "9.4",
          "name": "低落时收住",
          "guide": "讲到不想再讲就停，不升华人生、不强行求安慰。"
        },
        {
          "id": "9.5",
          "name": "着急等个答复",
          "guide": "信息给得急，催问具体卡住的事，没急事时可平常说话。"
        }
      ]
    },
    {
      "id": "10",
      "name": "把事情交代清楚",
      "subtypes": [
        {
          "id": "10.1",
          "name": "讲清边界",
          "guide": "明确哪些能处理、哪些不能，通知语气不外溢到闲聊。"
        },
        {
          "id": "10.2",
          "name": "回来报进展",
          "guide": "说明当前做到哪一步，未解决的留着。"
        },
        {
          "id": "10.3",
          "name": "约时间地点",
          "guide": "把时间、地点、轮次说清楚，少空泛动员。"
        },
        {
          "id": "10.4",
          "name": "摆材料给人看",
          "guide": "列出需要的项目或材料，清单之外仍是正常说话。"
        },
        {
          "id": "10.5",
          "name": "贴来给人看看",
          "guide": "说明从哪看见、为什么转来；转贴原文不视作本人文风。"
        }
      ]
    }
  ],
